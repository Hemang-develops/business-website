VITE_MAINTENANCE_MODE=true

# Stripe
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Supabase (optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API Base URL (for development, defaults to current origin)
VITE_API_BASE_URL=
